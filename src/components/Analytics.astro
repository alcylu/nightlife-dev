<aside id="analytics-choice" aria-label="Optional analytics" class="fixed bottom-4 left-4 right-4 z-50 mx-auto hidden max-w-xl rounded-xl border border-border bg-bg-card p-4 text-sm shadow-xl">
  <p class="mb-3 text-text-muted">Help us improve signup and checkout? Optional first-party analytics counts visits and steps, not form contents. <a class="text-primary underline" href="/privacy">Details</a></p>
  <div class="flex gap-3"><button id="analytics-yes" class="rounded-lg bg-primary px-4 py-2 text-white">Allow analytics</button><button id="analytics-no" class="rounded-lg border border-border px-4 py-2">No thanks</button></div>
</aside>
<script>
  import { track } from "../lib/analytics";
  track("page_view");
  const choice = document.getElementById("analytics-choice")!;
  try {
    if (!localStorage.getItem("nlt_analytics_consent") && navigator.doNotTrack !== "1" && !(navigator as Navigator & {globalPrivacyControl?: boolean}).globalPrivacyControl) choice.classList.remove("hidden");
    for (const [id, value] of [["analytics-yes","yes"],["analytics-no","no"]]) document.getElementById(id)!.addEventListener("click",()=>{
      try { localStorage.setItem("nlt_analytics_consent",value); if(value==="no")sessionStorage.removeItem("nlt_funnel_visit"); } catch {}
      choice.classList.add("hidden");
      if(value==="yes")track("page_view");
    });
  } catch {}
  document.addEventListener("click", event => {
    const anchor = (event.target as Element)?.closest?.("a");
    if (!anchor) return;
    try {
      const url = new URL(anchor.href, location.origin);
      if (url.origin === location.origin && url.pathname.replace(/\/$/,"") === "/checkout") track("plan_click",url.searchParams.get("plan") || undefined);
    } catch {}
  });
</script>
